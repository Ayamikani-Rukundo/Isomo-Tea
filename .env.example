# Browser-visible Supabase project settings (safe to expose with database RLS).
# Copy this file to .env.local and replace these example values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional. Set only after publishing the APK to a stable HTTPS URL.
VITE_ANDROID_APK_URL=
VITE_ANDROID_APK_VERSION=
VITE_ANDROID_APK_SIZE=
